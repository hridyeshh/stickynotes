{
  "manifest_version": 3,
  "name": "stickynotes",
  "version": "0.4.0",
  "description": "Select text on any page to keep it as a note, filed under its topic with every source listed.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "alarms", "activeTab", "scripting"],
  "host_permissions": ["http://localhost:8080/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "page.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "stickynotes", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save selected text as a note"
    }
  }
}
