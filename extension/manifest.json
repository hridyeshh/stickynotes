{
  "manifest_version": 3,
  "name": "Highlight Notes",
  "version": "1.0.0",
  "description": "Select text on any page to save it as a note, grouped under that page's heading.",
  "permissions": ["storage", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Highlight Notes" },
  "commands": {
    "save-selection": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save selected text as a note"
    }
  }
}
